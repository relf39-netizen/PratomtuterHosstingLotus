# ==============================================================================
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/schoobwd/repositories/PratomtuterHosstingLotus"
PassengerBaseURI "/"
PassengerNodejs "/home/schoobwd/nodevenv/repositories/PratomtuterHosstingLotus/22/bin/node"
PassengerAppType node
PassengerStartupFile app.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
# ==============================================================================
PassengerFriendlyErrorPages on

# ==============================================================================
# Pratom Smart Tutor - cPanel / Apache / LiteSpeed Configuration
# ==============================================================================

# 1. Prioritize dist/index.html for directory indexes
DirectoryIndex dist/index.html index.html

# 2. Correct MIME Types
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/wasm .wasm
  AddType application/json .json
  AddType application/manifest+json .webmanifest .json
</IfModule>

# 3. Prevent HTML caching so deployments update immediately
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# 4. URL Rewriting for Static Assets and SPA
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow all /api and /api/* requests to pass through directly to Passenger / Node.js
  RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
  RewriteRule .* - [L]

  # Block direct access to raw TypeScript, source code, and sensitive files (allow manifest.json)
  RewriteRule ^src/ - [F,L]
  RewriteRule ^(package|package-lock|tsconfig|build)\.json$ - [F,L]
  RewriteRule \.(ts|tsx|env|mjs|config\.ts)$ - [F,L]

  # Allow public files like manifest.json and logo.svg
  RewriteRule ^manifest\.json$ dist/manifest.json [L]
  RewriteRule ^logo\.svg$ dist/logo.svg [L]
  RewriteRule ^sw\.js$ dist/sw.js [L]

  # 1. If requesting domain root '/' or 'index.html', serve dist/index.html directly
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # 2. If the requested file exists inside dist/, serve it directly from dist/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 3. Explicitly map /assets/* to dist/assets/*
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 4. SPA Fallback: Route all non-file, non-API requests to dist/index.html
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_URI} !^/api(/.*)?$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ dist/index.html [L]
</IfModule>
